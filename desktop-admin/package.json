{
  "name": "leflow-admin-desktop",
  "productName": "LeFlow Admin",
  "version": "1.0.0",
  "description": "Desktop shell for the Studio LeFlow admin panel",
  "main": "src/main.js",
  "author": "Studio LeFlow",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fix-electron.js",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studioleflow.admin",
    "productName": "LeFlow Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
